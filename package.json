{
  "name": "copilot-usage-logger",
  "displayName": "Lloyds Banking Group — Copilot Usage Logger",
  "description": "Local-only logging and classification of your Copilot Chat usage, with a dashboard by category, language, model, and day.",
  "version": "0.1.0",
  "publisher": "local-dev",
  "private": true,
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "usageLogger.openDashboard",
        "title": "Copilot Usage: Open Dashboard"
      },
      {
        "command": "usageLogger.rescanHistory",
        "title": "Copilot Usage: Rescan Chat History"
      },
      {
        "command": "usageLogger.purgeData",
        "title": "Copilot Usage: Purge All Logged Data"
      }
    ],
    "chatParticipants": [
      {
        "id": "usageLogger.usage",
        "name": "usage",
        "description": "Query your local Copilot usage stats.",
        "isSticky": false,
        "commands": [
          {
            "name": "stats",
            "description": "Show a quick summary of your Copilot usage."
          }
        ]
      }
    ],
    "configuration": {
      "title": "Copilot Usage Logger",
      "properties": {
        "usageLogger.enablePassiveCapture": {
          "type": "boolean",
          "default": true,
          "description": "Automatically watch and parse local Copilot Chat session files."
        },
        "usageLogger.retentionDays": {
          "type": "number",
          "default": 0,
          "description": "Delete logged requests older than this many days. 0 = keep forever."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "vsce-package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.27.0"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "sql.js": "^1.10.3"
  }
}
